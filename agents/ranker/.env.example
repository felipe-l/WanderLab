# Required
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbG...
DISCORD_WEBHOOK_AGENT_LOGS=https://discord.com/api/webhooks/...
OPENROUTER_API_KEY=sk-or-...
GEMINI_API_KEY=AIza...
AGENT_NAME=ranker

# Optional — defaults shown
RANKER_TOP_N=10
RUN_ID=                          # optional, uses latest run if empty

# Clustering levers
RANKER_MIN_CLUSTER_SIZE=5        # min complaints to form a cluster (lower = more clusters)
RANKER_MIN_SAMPLES=2             # noise strictness: 1=least strict, higher=more noise
RANKER_CLUSTER_EPSILON=0.0       # merge resistance: 0.0=merge freely, higher=keep clusters separate
RANKER_CLUSTER_SELECTION_METHOD=eom  # eom=stable broad clusters, leaf=many specific clusters
RANKER_UMAP_DIMS=15              # dimensions after reduction (10-25 range)
RANKER_UMAP_NEIGHBORS=15         # local neighborhood size for UMAP (higher=more global structure)
RANKER_MAX_CLUSTER_SIZE=50       # clusters above this get recursively split

# Scoring weights — composite = W_DATA * data_score + W_LLM * llm_score
RANKER_W_DATA=0.5                # overall weight for hard data signals
RANKER_W_LLM=0.5                 # overall weight for LLM-judged signals
# Data sub-weights (should sum to ~1.0)
RANKER_W_VOLUME=0.30             # complaint count (log-scaled, diminishing returns)
RANKER_W_DIVERSITY=0.45          # unique products — cross-product = market gap signal
RANKER_W_ENGAGEMENT=0.25         # avg reddit upvotes — community validation
# LLM sub-weights (should sum to ~1.0)
RANKER_W_INTENSITY=0.30          # user frustration level
RANKER_W_WTP=0.45                # willingness to pay — the whole point
RANKER_W_AI_FIT=0.25             # could AI solve this?
