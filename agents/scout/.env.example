APPSTORE_MIN_STAR_RATING=1   # inclusive lower bound (1-5)
APPSTORE_MAX_STAR_RATING=3   # inclusive upper bound (1-5)

# Google Play — leave blank to disable
GOOGLEPLAY_APP_IDS=
GOOGLEPLAY_MIN_STAR_RATING=1          # inclusive lower bound (1-5)
GOOGLEPLAY_MAX_STAR_RATING=3          # inclusive upper bound (1-5)
GOOGLEPLAY_MAX_REVIEWS_PER_STAR=200   # max reviews fetched per app per star rating
